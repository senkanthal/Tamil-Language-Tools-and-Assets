{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "tamil-language-tools-and-assets",
  "version": "1.1.0",
  "description": "Tamil ASCII font to Unicode and reverse regex mappings",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Senkanthal/Tamil-Language-Tools-and-Assets.git"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "changeset": "changeset",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "build": "tsc -p tsconfig.json",
    "version-packages": "changeset version",
    "test": "npm run test:node",
    "test:bun": "bun test test/index.test.ts",
    "test:node": "npm run build && node --test test/index.node.test.mjs",
    "clean": "rimraf dist",
    "format": "prettier --write .",
    "knip": "knip",
    "knip:depcheck": "knip --dependencies",
    "knip:fix": "knip --fix",
    "prepare": "husky"
  },
  "keywords": [
    "tamil",
    "unicode",
    "bamini",
    "tamil fonts",
    "regex",
    "text conversion",
    "ocr"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "husky": "^9.1.7",
    "knip": "^6.7.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  }
}
